@model IEnumerable<PersonResponse>
@{
    ViewBag.Title = "Persons";
    var persons = Model.ToList();
}

<h1>Persons</h1>

<div class="download-buttons">

    <div class="flex">
        <div class="flex-1">
            <div class="text-grey">
                <span>Contacts</span>
                <i class="fa-solid fa-caret-right"></i>
                <span class="text-grey">Persons</span>
            </div>
        </div>
        </div>
        
        <form asp-controller="Persons" asp-action="Create" method="get"> 
        <button type="submit" class="button">
            Create Person
        </button>
    </form>

    <form asp-controller="Persons" asp-action="PersonsPdf" method="post">
        @for (int i = 0; i < persons.Count; i++)
        {
            <input type="hidden" name="persons[@i].PersonName" value="@persons[i].PersonName" />
            <input type="hidden" name="persons[@i].Email" value="@persons[i].Email" />
            <input type="hidden" name="persons[@i].DateOfBirth" value="@persons[i].DateOfBirth" />
            <input type="hidden" name="persons[@i].Age" value="@persons[i].Age" />
            <input type="hidden" name="persons[@i].Gender" value="@persons[i].Gender" />
            <input type="hidden" name="persons[@i].Country" value="@persons[i].Country" />
            <input type="hidden" name="persons[@i].Address" value="@persons[i].Address" />
            <input type="hidden" name="persons[@i].ReceiveNewsLetters" value="@persons[i].ReceiveNewsLetters" />
        }

        <button type="submit" class="button">
            Download as PDF
        </button>
    </form>

    <form asp-controller="Persons" asp-action="PersonsCSV" method="post">
        @for (int i = 0; i < persons.Count; i++)
        {
            <input type="hidden" name="persons[@i].PersonName" value="@persons[i].PersonName" />
            <input type="hidden" name="persons[@i].Email" value="@persons[i].Email" />
            <input type="hidden" name="persons[@i].DateOfBirth" value="@persons[i].DateOfBirth" />
            <input type="hidden" name="persons[@i].Age" value="@persons[i].Age" />
            <input type="hidden" name="persons[@i].Gender" value="@persons[i].Gender" />
            <input type="hidden" name="persons[@i].Country" value="@persons[i].Country" />
            <input type="hidden" name="persons[@i].Address" value="@persons[i].Address" />
            <input type="hidden" name="persons[@i].ReceiveNewsLetters" value="@persons[i].ReceiveNewsLetters" />
        }

        <button type="submit" class="button">
            Download as CSV
        </button>
    </form>

    <form asp-controller="Persons" asp-action="PersonsExcel" method="post">
        @for (int i = 0; i < persons.Count; i++)
        {
            <input type="hidden" name="persons[@i].PersonName" value="@persons[i].PersonName" />
            <input type="hidden" name="persons[@i].Email" value="@persons[i].Email" />
            <input type="hidden" name="persons[@i].DateOfBirth" value="@persons[i].DateOfBirth" />
            <input type="hidden" name="persons[@i].Age" value="@persons[i].Age" />
            <input type="hidden" name="persons[@i].Gender" value="@persons[i].Gender" />
            <input type="hidden" name="persons[@i].Country" value="@persons[i].Country" />
            <input type="hidden" name="persons[@i].Address" value="@persons[i].Address" />
            <input type="hidden" name="persons[@i].ReceiveNewsLetters" value="@persons[i].ReceiveNewsLetters" />
        }

        <button type="submit" class="button">
            Download as Excel
        </button>
    </form>

</div>


<form asp-controller="Persons" asp-action="Index" method="get">
     
    <div class="box flex">
        <div class="flex-1">
            <select class="form-input" name="searchBy">
                @foreach (var item in ViewBag.SearchFields)
                {
                    if (item.Key == ViewBag.CurrentSearchBy)
                    {
                        <option value="@ViewBag.CurrentSearchBy" selected="selected">@item.Value</option>
                    }
                    else
                    {
                        <option value="@item.Key">@item.Value</option>
                    }
                }
            </select>
        </div>

        <div class="flex-1">
            <input type="search" id="Search" class="form-input" placeholder="Search" name="searchString" value="@ViewBag.CurrentSearchString" />
        </div>

        <div class="flex-1">
            <button class="button button-blue-back">Search</button>
            <a asp-controller="Persons" asp-action="Index" class="link-hover">Clear All</a>
        </div>
    </div>

    <table class="table w-100 mt saba-contacts">
        <thead>
            <tr>
                @await Html.PartialAsync("_ColumnHeader", new ViewDataDictionary(ViewData){
                                {"ColumnName", nameof(PersonResponse.PersonName)},
                                {"DisplayName", "Person Name"},
                    })
                @await Html.PartialAsync("_ColumnHeader", new ViewDataDictionary(ViewData){
                                {"ColumnName", nameof(PersonResponse.Email)},
                                {"DisplayName", "Email"},
                    })
                @await Html.PartialAsync("_ColumnHeader", new ViewDataDictionary(ViewData){
                                {"ColumnName", nameof(PersonResponse.DateOfBirth)},
                                {"DisplayName", "Date of Birth"},
                    })
                @await Html.PartialAsync("_ColumnHeader", new ViewDataDictionary(ViewData){
                                {"ColumnName", nameof(PersonResponse.Age)},
                                {"DisplayName", "Age"},
                    })
                @await Html.PartialAsync("_ColumnHeader", new ViewDataDictionary(ViewData){
                                {"ColumnName", nameof(PersonResponse.Gender)},
                                {"DisplayName", "Gender"},
                    })
                @await Html.PartialAsync("_ColumnHeader", new ViewDataDictionary(ViewData){
                                {"ColumnName", nameof(PersonResponse.Country)},
                                {"DisplayName", "Country"},
                    })
                @await Html.PartialAsync("_ColumnHeader", new ViewDataDictionary(ViewData){
                                {"ColumnName", nameof(PersonResponse.Address)},
                                {"DisplayName", "Address"},
                    })
                @await Html.PartialAsync("_ColumnHeader", new ViewDataDictionary(ViewData){
                                {"ColumnName", nameof(PersonResponse.ReceiveNewsLetters)},
                                {"DisplayName", "Receive News Letters"},
                    })
                <th>Options</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (PersonResponse person in Model)
            {
                <tr>
                    <td style="width:10%">@person.PersonName</td>
                    <td style="width:16%">@person.Email</td>
                    <td style="width:14%">@person.DateOfBirth?.ToString("dd MMM yyyy")</td>
                    <td style="width:6%">@person.Age</td>
                    <td style="width:9%">@person.Gender</td>
                    <td style="width:12%">@person.Country</td>
                    <td style="width:16%">@person.Address</td>
                    <td style="width:17%">@person.ReceiveNewsLetters</td>
                    <td style="width:20%">
                        <a asp-controller="Persons" asp-action="Edit" asp-route-personID="@person.PersonID">Edit</a>
                    </td>
                    <td style="width:20%">
                        <a asp-controller="Persons" asp-action="Delete" asp-route-personID="@person.PersonID">Delete</a>
                    </td>
                </tr>
            }
            <tr>
            </tr>
        </tbody>
    </table>

</form>