@model IEnumerable<PersonResponse>
@{
    Layout = null;
}

<link href="@("https://" + Context.Request.Host.ToString() + "/modernized.css")" rel="stylesheet" />

 
<h1>Persons</h1>

<table class="table w-100 mt">
    <thead>
        <tr>
            <th>Person Name</th>
            <th>Email</th>
            <th>Date of Birth</th>
            <th>Age</th>
            <th>Gender</th>
            <th>Country</th>
            <th>Address</th>
            <th>Receive News Letters</th> 
        </tr>
    </thead>
    <tbody>
        @foreach (PersonResponse person in Model)
        {
            <tr>
                <td style="width:10%">@person.PersonName</td>
                <td style="width:16%">@person.Email</td>
                <td style="width:14%">@person.DateOfBirth?.ToString("dd MMM yyyy")</td>
                <td style="width:6%">@person.Age</td>
                <td style="width:9%">@person.Gender</td>
                <td style="width:12%">@person.Country</td>
                <td style="width:16%">@person.Address</td>
                <td style="width:17%">@person.ReceiveNewsLetters</td> 
            </tr>
        }
        <tr>
        </tr>
    </tbody>
</table>

 